{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyu.local/schemas/gateway.schema.json",
  "title": "gateway config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "listen",
    "cert",
    "reload",
    "upstream"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipv4",
        "ipv6",
        "port"
      ],
      "properties": {
        "ipv4": {
          "type": "string"
        },
        "ipv6": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "cert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certFile",
        "keyFile"
      ],
      "properties": {
        "certFile": {
          "type": "string"
        },
        "keyFile": {
          "type": "string"
        }
      }
    },
    "reload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onStart",
        "pollInterval",
        "watch",
        "signal",
        "api"
      ],
      "properties": {
        "onStart": {
          "type": "boolean"
        },
        "pollInterval": {
          "type": "string"
        },
        "watch": {
          "type": "boolean"
        },
        "signal": {
          "type": "boolean"
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "listen",
            "tokenFile"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "listen": {
              "type": "string"
            },
            "tokenFile": {
              "type": "string"
            }
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
