{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moyu.local/schemas/worker.schema.json",
  "title": "worker config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "concurrency", "jobTimeoutSeconds", "pollIntervalSeconds"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
    "jobTimeoutSeconds": { "type": "integer", "minimum": 30 },
    "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
  }
}