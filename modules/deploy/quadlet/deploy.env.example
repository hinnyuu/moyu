# 由部署环境填写；不要在仓库里提交真实值。
MOYU_IMAGE=ghcr.io/hinnyuu/moyu:<version>
MOYU_CONFIG_DIR=<config-dir>
MOYU_DATA_DIR=<data-dir>
MOYU_SECRETS_DIR=<secrets-dir>
MOYU_CERTS_DIR=<certs-dir>
MOYU_API_PORT=<api-port>
MOYU_PREVIEW_PORT=<preview-port>
MOYU_GATEWAY_PORT=<gateway-port>
MOYU_PUBLIC_PORT=<public-port>
MOYU_TUSD_PORT=<tusd-port>
MOYU_TUSD_BASE_PATH=/files/
MOYU_TUSD_HOOK_TOKEN=<secret>
